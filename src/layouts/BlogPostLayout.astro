---
import BaseLayout from './BaseLayout.astro';
import type { Props as BaseProps } from './BaseLayout.astro';

interface Props extends BaseProps {
  heroImage: string;
  heroImageAlt: string;
}

const { heroImage, heroImageAlt, ...baseProps } = Astro.props as Props;
---

<BaseLayout {...baseProps}>
  <img src={heroImage} alt={heroImageAlt} width="1200" height="600" class="hero-image">
  <slot />
</BaseLayout>

<style>
.hero-image {
  width: 100%;
  max-height: 400px;
  object-fit: cover;
  margin-bottom: 2rem;
}
</style>