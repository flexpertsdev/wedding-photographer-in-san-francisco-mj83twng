---
// ServiceCard.astro
interface Props {
  title: string;
  description: string;
  imageUrl: string;
  imageAlt: string;
  price: string;
  link: string;
}

const { title, description, imageUrl, imageAlt, price, link } = Astro.props;
---

<div class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col h-full transition-shadow hover:shadow-lg">
  <img src={imageUrl} alt={imageAlt} class="w-full h-48 object-cover object-center" loading="lazy" />
  <div class="p-4 flex-grow">
    <h3 class="text-xl font-semibold text-gray-800 mb-2">{title}</h3>
    <p class="text-gray-600 text-sm mb-4 flex-grow">{description}</p>
  </div>
  <div class="p-4 border-t border-gray-200">
    <div class="flex items-center justify-between">
      <span class="text-lg font-bold text-gray-900">{price}</span>
      <a href={link} class="inline-block bg-rose-500 text-white py-2 px-4 rounded-md hover:bg-rose-600 transition-colors font-semibold">Learn More</a>
    </div>
  </div>
</div>