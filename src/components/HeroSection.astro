---
// HeroSection.astro
interface Props {
  title: string;
  subtitle: string;
  imageUrl: string;
  imageAlt: string;
  ctaText: string;
  ctaLink: string;
  className?: string; // Optional classes for customization
}

const { title, subtitle, imageUrl, imageAlt, ctaText, ctaLink, className = '' } = Astro.props;
---

<section class={`relative py-24 md:py-32 bg-gray-100 overflow-hidden ${className}`}>
  <div class="absolute inset-0 h-full w-full object-cover object-center bg-cover bg-no-repeat" style={`background-image: url(${imageUrl}); filter: grayscale(20%); opacity: 0.7;`}></div>

  <div class="relative container mx-auto px-4">
    <div class="text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-800 leading-tight mb-4 drop-shadow-md">{title}</h1>
      <p class="text-lg md:text-xl text-gray-700 mb-8 drop-shadow-md">{subtitle}</p>
      <a href={ctaLink} class="inline-block bg-primary text-white py-3 px-6 rounded-md hover:bg-primary-dark transition-colors font-semibold shadow-md">{ctaText}</a>
    </div>
  </div>
</section>

<style>
  .bg-primary {
    background-color: theme('colors.rose.600'); /* Example using Tailwind's theme */
  }

  .bg-primary-dark {
    background-color: theme('colors.rose.700');
  }
</style>