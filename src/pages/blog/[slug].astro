---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Markdown } from 'astro/components'; //For rendering MDX content
import Layout from '../../layouts/BlogPostLayout.astro'; // Create a custom layout
import type { GetStaticPaths } from 'astro';


export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props as Props;
const { Content } = await post.render(); //Important to retrieve the content
---

<Layout title={post.data.title} description={post.data.description} heroImage={post.data.heroImage} heroImageAlt={post.data.heroImageAlt}>
  <article class="blog-post">
    <h1>{post.data.title}</h1>
    <p class="publish-date">Published: {post.data.pubDate.toLocaleDateString()}</p>
     <Content />  //Render the markdown/MDX content
    {/* Add other elements, e.g. author, categories, related posts, comments, etc. here. */}
  </article>
</Layout>